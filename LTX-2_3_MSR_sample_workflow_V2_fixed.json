i/ComfyUI-PromptRelay","ver":"ca5d4e3edb6abd9c2a4c68a3a6798eec1980f450","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["参考画像1：女子学生A。image 1の人物。女性。長い髪、学生服、顔、髪型、服装を保つ。\n\n参考画像2：女子学生B。image 2の人物。女性。長い髪、学生服、顔、髪型、服装を保つ。\n\n背景画像：人物のいない背景。背景の場所、照明、色味を保つ。\n\n重要：image 1とimage 2はどちらも女子学生。男性にしない。2人を混同しない。顔、髪型、服装を入れ替えない。","学生Aと学生Bが背景画像の場所に並んで立っている。2人はイヤホンで音楽を聴きながら、リズムに合わせて肩と上半身を小さく揺らしている。表情は自然で楽しそう。\n\n学生Aが少し笑い、音楽に合わせて軽く首を振る。学生Bも隣でリズムに乗り、片足に体重を移しながら小さく体を揺らす。2人の顔と服装は参照画像のまま保つ。\n\nカメラは中景で2人を映し続ける。学生Aと学生Bは互いに少し視線を合わせ、笑顔で音楽を楽しむ。動きは大きすぎず、自然なリズム。\n\n最後に2人が同じリズムで軽く体を揺らし、自然に笑う。背景は安定し、人物の入れ替わりや顔の混同は起こらない。\n\n ","",0.0022]},{"id":6,"type":"CLIPTextEncode","pos":[-270,294.59139965172767],"size":[400,200],"flags":{},"order":27,"mode":0,"inputs":[{"localized_name":"クリップ","name":"clip","type":"CLIP","link":457},{"localized_name":"テキスト","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"条件付け","name":"CONDITIONING","type":"CONDITIONING","links":[450]}],"properties":{"Node name for S&R":"CLIPTextEncode","cnr_id":"comfy-core","ver":"0.20.1","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["male, man, boy, masculine face, beard, short hair, gender swap, 男性, 男, 少年, ひげ, 男顔, 性別変更, 人物の入れ替わり, 顔の混同, 服装の混同"]},{"id":28,"type":"LiconMSR","pos":[1264.0505396168987,-761.3546832203411],"size":[270,190],"flags":{},"order":30,"mode":0,"inputs":[{"localized_name":"1","name":"1","shape":7,"type":"IMAGE","link":466},{"localized_name":"2","name":"2","shape":7,"type":"IMAGE","link":464},{"localized_name":"3","name":"3","shape":7,"type":"IMAGE","link":null},{"localized_name":"4","name":"4","shape":7,"type":"IMAGE","link":null},{"localized_name":"background","name":"background","shape":7,"type":"IMAGE","link":462},{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":119},{"localized_name":"height","name":"height","type